# Copy this file to .env and fill in the values. This file is committed; .env is not.

# Firebase web config, from the Firebase console: Project settings, Your apps.
# Not secret, since it ships inside any Firebase client. The Firestore rules
# protect the data, not these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Places API (New), used by Fuel. Get the value from the Google Cloud
# console under the swiftchoice-places project, or ask the team lead.
#
# Never put it in this file. Google scans public repos and disables keys it
# finds, which would take Eat Out down for everyone. The key is restricted to
# Places API (New), so a leak cannot be spent on any other Google service.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Priority AI tie-breaker Worker endpoint. Public configuration, not a secret.
EXPO_PUBLIC_PRIORITY_AI_URL=