# Copy this file to .env and fill in the values from the Firebase console.
#
# Open the Firebase console at https://console.firebase.google.com,
# pick the SwiftChoice project, click the gear icon next to "Project
# Overview", scroll to "Your apps", and copy the web config values.
#
# The values are not secrets in the cryptographic sense (they ship with
# any client that uses Firebase), so do not treat them as credentials.
# Security comes from the Firestore rules at firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Places API (New), used by Fuel to find real nearby places.
#
# Get the value yourself from the Google Cloud console at
# https://console.cloud.google.com: pick the swiftchoice-places project
# (not the Firebase one), then APIs and Services, Credentials, click the
# key, Show key. Ask the team lead if you cannot see it.
#
# NEVER put the value in this file. This file is committed; .env is not.
# Google scans public code hosts for leaked keys and can disable one it
# finds, which would take Eat Out down for everyone at once. That risk is
# what keeps the value out of the repo, not the value being confidential:
# like the Firebase values above it is compiled into the app bundle, so it
# was never a secret in the cryptographic sense.
#
# What limits the damage if it does leak is the restriction on the key
# itself, which allows Places API (New) and nothing else, so it cannot be
# spent on any other Google service. A per-day quota cap is not available
# on a trial account, so the other real control is the field list in
# src/services/recommendation/googlePlaces.ts, which keeps calls in the
# cheaper tier and has a test that fails if it changes.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
